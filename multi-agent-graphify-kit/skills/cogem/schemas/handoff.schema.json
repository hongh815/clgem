{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cogem:schema:handoff:1",
  "title": "Cogem Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id",
    "from_agent",
    "to_agent",
    "task_id",
    "status",
    "summary",
    "artifacts",
    "verification",
    "created_at"
  ],
  "properties": {
    "handoff_id": {
      "type": "string",
      "pattern": "^HANDOFF-[0-9]{3,}$"
    },
    "from_agent": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "to_agent": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3,}$"
    },
    "status": {
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "completed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
