{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cogem:schema:decision:1",
  "title": "Cogem Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "title",
    "status",
    "owner",
    "rationale",
    "affected_paths",
    "created_at"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^DEC-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "superseded",
        "rejected"
      ]
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "affected_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^DEC-[0-9]{3,}$"
    }
  }
}
