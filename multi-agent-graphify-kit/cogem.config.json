{
  "version": 1,
  "objective": "Drive user instructions through a persistent leader-owned Goal loop with real Worker delegation, graph-aware execution, independent review, and evidence-backed completion.",
  "phase": "bootstrap",
  "state_dir": ".agents",
  "graph_dir": ".graph",
  "comm_file": "Comm.md",
  "model_policy_file": "agent-models.json",
  "ignore": [
    ".git/**",
    ".venv/**",
    "dist/**",
    "build/**",
    "*.zip"
  ],
  "json_reference_keys": [
    "path",
    "paths",
    "file",
    "files",
    "artifact",
    "artifacts",
    "affected_paths",
    "read_set",
    "write_set",
    "impact_set",
    "core_impact_set",
    "state_dir",
    "graph_dir",
    "comm_file",
    "model_policy_file",
    "core_paths"
  ],
  "core_paths": [
    "AGENTS.md",
    "Comm.md",
    "cogem.config.json",
    "agent-models.json",
    "docs/skill-authoring.md",
    "skills/cogem/SKILL.md",
    "skills/cogem/manifest.txt",
    "skills/cogem/references/leader-loop.md",
    "skills/cogem/schemas/goal.schema.json",
    "skills/cogem/schemas/task.schema.json",
    "skills/cogem/schemas/report.schema.json",
    "src/cogem/contracts.py",
    "src/cogem/dispatch.py",
    "src/cogem/goal.py",
    "src/cogem/skill_policy.py",
    "src/cogem/validation.py",
    "skills/cogem/schemas/scope-snapshot.schema.json",
    "src/cogem/task_policy.py",
    "src/cogem/scope.py",
    "src/cogem/skill_init.py"
  ],
  "max_concurrent_source_writers": 2,
  "recent_message_limit": 20
}
