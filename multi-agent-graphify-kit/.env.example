# Cogem resolves execution engines from environment variables.
# Copy the exact Plan A values from model-presets/plan-a-gpt-antigravity.env.
# Never store provider API keys in this file.
COGEM_COORDINATOR_ENGINE=
COGEM_BALANCED_ENGINE=
COGEM_REVIEW_ENGINE=

# Emergency GPT-only review is disabled by default. Both values are required
# only when a Coordinator explicitly approves degraded independence.
COGEM_REVIEW_FALLBACK_ENGINE=
COGEM_ALLOW_DEGRADED_REVIEW=false
